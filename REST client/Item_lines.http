@host = http://127.0.0.1:8000
@api_key = a1b2c3d4e5
@test_id = 9999999999

### Get all item lines
GET {{host}}/api/v1/item_lines/
Authorization: Bearer {{api_key}}

### Get specific item line
GET {{host}}/api/v1/item_lines/{{test_id}}/
Authorization: Bearer {{api_key}}

### Put update item line
PUT {{host}}/api/v1/item_lines/{{test_id}}/
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
    "id": {{test_id}},
    "name": "Updated Item Line",
    "description": "Updated description"
}

### Post new item line
POST {{host}}/api/v1/item_lines/
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
    "id": {{test_id}},
    "name": "New Item Line",
    "description": "New line description"
}

### Delete item line
DELETE {{host}}/api/v1/item_lines/{{test_id}}/
Authorization: Bearer {{api_key}}
