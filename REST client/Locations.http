# @host = http://localhost:8080
@host = http://127.0.0.1:8000
@api_key = DYXcU3AshPCpUC0PzM1BMDnUbcoroGZm
@test_id = 1

### Get all locations
GET {{host}}/api/v1/locations/
Authorization: Bearer {{api_key}}

### Get specific location
GET {{host}}/api/v1/locations/{{test_id}}/
Authorization: Bearer {{api_key}}

### Post new location
POST {{host}}/api/v1/locations/
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
    "warehouse_id": 1,
    "code": "A.1.1",
    "name": "Row: A, Rack: 1, Shelf: 1",
    "address": "123 Warehouse St",
    "city": "Warehouse City",
    "province": "Warehouse Province",
    "country": "Warehouse Country"
}

### Put update location
PUT {{host}}/api/v1/locations/{{test_id}}/
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
    "warehouse_id": 1,
    "code": "UPDATED-A.1.1",
    "name": "Updated Row: A, Rack: 1, Shelf: 1",
    "address": "123 Warehouse St",
    "city": "Warehouse City",
    "province": "Warehouse Province",
    "country": "Warehouse Country"
}

### Delete location
DELETE {{host}}/api/v1/locations/{{test_id}}/
Authorization: Bearer {{api_key}}