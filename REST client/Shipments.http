@host = http://127.0.0.1:8000
@api_key = a1b2c3d4e5
@shipment_id = 1

### Get all shipments
GET {{host}}/api/v1/shipments/
Authorization: Bearer {{api_key}}

### Get specific shipment
GET {{host}}/api/v1/shipments/{{shipment_id}}/
Authorization: Bearer {{api_key}}

### Post new shipment
POST {{host}}/api/v1/shipments/
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
    "name": "New Shipment",
    "origin": "Warehouse A",
    "destination": "Warehouse B"
}

### Put update shipment
PUT {{host}}/api/v1/shipments/{{shipment_id}}/
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
    "name": "Updated Shipment",
    "origin": "Warehouse X",
    "destination": "Warehouse Y"
}

### Delete shipment
DELETE {{host}}/api/v1/shipments/{{shipment_id}}/
Authorization: Bearer {{api_key}}
