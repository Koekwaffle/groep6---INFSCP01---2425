# @host = http://localhost:8080
@host = http://127.0.0.1:8000
@api_key = a1b2c3d4e5
@test_id = 9999999999

### Get all suppliers
GET {{host}}/api/v1/suppliers/
Authorization: Bearer {{api_key}}

### Get specific supplier
GET {{host}}/api/v1/suppliers/{{test_id}}/
Authorization: Bearer {{api_key}}

### Put update supplier
PUT {{host}}/api/v1/suppliers/{{test_id}}/
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
    "id": {{test_id}},
    "name": "Updated Supplier",
    "contact_name": "Updated Contact",
    "contact_email": "updated@supplier.com",
    "contact_phone": "987-654-3210"
}

### Post new supplier
POST {{host}}/api/v1/suppliers/
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
    "name": "New Supplier",
    "contact_name": "John Doe",
    "contact_email": "john@supplier.com",
    "contact_phone": "123-456-7890"
}

### Delete supplier
DELETE {{host}}/api/v1/suppliers/{{test_id}}/
Authorization: Bearer {{api_key}}