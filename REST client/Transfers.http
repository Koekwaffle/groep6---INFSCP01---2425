@host = http://127.0.0.1:8000
@api_key = DYXcU3AshPCpUC0PzM1BMDnUbcoroGZm
@test_id = 1

### Get all transfers
GET {{host}}/api/v1/transfers/
Authorization: Bearer {{api_key}}

### Get specific transfer
GET {{host}}/api/v1/transfers/{{test_id}}/
Authorization: Bearer {{api_key}}

### Post new transfer
POST {{host}}/api/v1/transfers/
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
    "from_location": 1,
    "to_location": 2,
    "item_id": 1,
    "quantity": 25,
    "status": "pending"
}

### Put update transfer
PUT {{host}}/api/v1/transfers/{{test_id}}/
Authorization: Bearer {{api_key}}
Content-Type: application/json

{
    "from_location": 1,
    "to_location": 2,
    "item_id": 1,
    "quantity": 50,
    "status": "updated",
    "transfer_status": "pending"
}

### Delete transfer
DELETE {{host}}/api/v1/transfers/{{test_id}}/
Authorization: Bearer {{api_key}}